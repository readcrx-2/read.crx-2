{
  "name": "chlens",
  "version": "5.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/22-2/chlens.git"
  },
  "scripts": {
    "// --- ビルド ---": "",
    "build": "pnpm build:chrome",
    "build:chrome": "cross-env PLATFORM=chrome ENTRY=browser vp build",
    "analyze:chrome": "cross-env PLATFORM=chrome ENTRY=browser ANALYZE=true vp build",
    "build:firefox": "cross-env PLATFORM=firefox ENTRY=browser vp build",
    "build:extensions": "run-s build:chrome build:firefox",
    "build:tauri": "tauri build",
    "// E2E用のTauri版。保存先を CHLENS_DATA_DIR へ差し替えられる実行ファイルだけを作り、インストーラーは作らない": "",
    "build:tauri:e2e": "tauri build --debug --no-bundle --features e2e",
    "// Tauriのパッケージ化前に、3つのWebView用資産を生成する内部スクリプト": "",
    "build:tauri:assets": "run-s build:tauri:main build:tauri:overlay build:tauri:replay",
    "build:tauri:main": "cross-env PLATFORM=tauri ENTRY=browser vp build",
    "build:tauri:overlay": "cross-env PLATFORM=tauri ENTRY=overlay vp build",
    "build:tauri:replay": "cross-env PLATFORM=tauri ENTRY=replay vp build",
    "// --- 開発・監視 ---": "",
    "dev:chrome": "cross-env PLATFORM=chrome ENTRY=browser VITE_WATCH_DEV=true vp build --watch --mode development",
    "watch:chrome": "pnpm dev:chrome",
    "watch:tauri": "run-p watch:tauri:main watch:tauri:overlay watch:tauri:replay",
    "watch:tauri:main": "cross-env PLATFORM=tauri ENTRY=browser VITE_WATCH_DEV=true vp build --watch --mode development",
    "watch:tauri:overlay": "cross-env PLATFORM=tauri ENTRY=overlay VITE_WATCH_DEV=true vp build --watch --mode development",
    "watch:tauri:replay": "cross-env PLATFORM=tauri ENTRY=replay VITE_WATCH_DEV=true vp build --watch --mode development",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "// WebView2のリモートデバッグを開け、pnpm debug:tauri から画面の状態とログを読めるようにする": "",
    "dev:tauri:debug": "cross-env WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS=--remote-debugging-port=9222 tauri dev",
    "debug:tauri": "node --no-warnings --experimental-strip-types scripts/chlens-debug.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "mcp:server": "node --experimental-strip-types scripts/chlens-mcp.ts",
    "// --- ユーティリティ・静的解析 ---": "",
    "clean": "node -e \"const fs=require('fs-extra'); ['debug/chrome','debug/firefox','debug/tauri'].forEach(d=>fs.removeSync(d))\"",
    "lint": "run-s -c -l lint:oxlint lint:format lint:tokens",
    "lint:oxlint": "vp lint --fix src/",
    "lint:format": "vp fmt",
    "lint:tokens": "node scripts/check-browser-design-tokens.mjs",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:rust:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lib --summary-only && cargo llvm-cov report --manifest-path src-tauri/Cargo.toml --html --output-dir coverage/rust",
    "test:coverage:all": "pnpm run test:coverage && pnpm run test:e2e:coverage && pnpm run test:coverage:merge",
    "test:coverage:merge": "node scripts/merge-coverage.mjs",
    "// E2Eはoffstage-windows経由で非表示デスクトップに窓を出す（Windows以外ではそのまま実行）。窓を見るときは OFFSTAGE=0": "",
    "test:e2e": "pnpm run build:chrome && offstage-windows node scripts/run-e2e.mjs --project=chrome",
    "test:e2e:tauri": "pnpm run build:tauri:e2e && offstage-windows node scripts/run-e2e.mjs --project=tauri",
    "test:e2e:coverage": "node scripts/e2e-coverage.mjs --e2e-only",
    "test:e2e:ui": "pnpm run build:chrome && playwright test --project=chrome --ui",
    "ui:shots": "pnpm run build:chrome && cross-env CHLENS_UI_SHOTS=true playwright test --project=chrome tests/ui-screenshots.spec.mts --workers=1",
    "ui:shots:tauri": "node --no-warnings --experimental-strip-types scripts/ui-screenshots-tauri.mts",
    "triage:todo": "node --no-warnings --experimental-strip-types scripts/triage-todo.ts",
    "release": "release-it",
    "release:build": "pnpm build:extensions && node scripts/package-release.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@rjsf/core": "^6.11.0",
    "@rjsf/utils": "^6.11.0",
    "@rjsf/validator-ajv8": "^6.11.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.3",
    "@tauri-apps/plugin-http": "2.8.3",
    "@tauri-apps/plugin-sql": "2.6.0",
    "@toon-format/toon": "4.4.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@url-sanitize/core": "2.0.2",
    "@url-sanitize/merged": "2.0.2",
    "buffer": "^6.0.3",
    "consola": "^3.4.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "escape-html": "^1.0.3",
    "fflate": "^0.8.3",
    "fuzzysort": "^4.0.2",
    "iconv-lite": "^0.7.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.57.0",
    "monaco-editor": "^0.57.0",
    "normalize-wheel": "^1.0.1",
    "playwright": "^1.64.1",
    "preact": "^11.0.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "store2": "^2.14.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.64.1",
    "@release-it/bumper": "^8.0.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.1.2",
    "jsonc-parser": "^3.3.1",
    "npm-run-all": "^4.1.5",
    "offstage-windows": "0.1.2",
    "release-it": "^21.1.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "webextension-polyfill": "^0.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=25.0"
  }
}
