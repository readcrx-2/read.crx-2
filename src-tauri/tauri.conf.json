{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "chlens",
  "version": "5.0.0",
  "identifier": "com.chlens.app",
  "build": {
    "frontendDist": "../debug/tauri",
    "beforeDevCommand": "pnpm watch:tauri",
    "beforeBuildCommand": "pnpm build:tauri:assets"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "chlens",
        "url": "view/index.html",
        "create": false,
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "comment-overlay",
        "title": "ChLens コメントOverlay",
        "url": "view/comment-overlay.html",
        "width": 900,
        "height": 506,
        "resizable": true,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true
      },
      {
        "label": "archive-replay",
        "title": "ChLens 過去実況再生",
        "url": "view/archive-replay.html",
        "width": 1000,
        "height": 720,
        "resizable": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "img-src": "'self' customprotocol: asset: http://* https://* data: blob:",
        "media-src": "'self' customprotocol: asset: http://* https://* blob:",
        "frame-src": "'self' customprotocol: asset: http://* https://* blob:",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "worker-src": "'self' blob:",
        "script-src": "'self' 'wasm-unsafe-eval'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
