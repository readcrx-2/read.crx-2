{
  "name": "chlens",
  "version": "5.0.0",
  "description": "2chブラウザ",
  "manifest_version": 3,
  "minimum_chrome_version": "103",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; default-src 'self'; img-src 'self' http: https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:; frame-src 'self' http: https: blob:; font-src data:; media-src 'self' http: https:; worker-src 'self';"
  },
  "incognito": "split",
  "options_ui": {
    "page": "view/index.html?q=config",
    "open_in_tab": true
  },
  "permissions": [
    "bookmarks",
    "cookies",
    "tabs",
    "storage",
    "unlimitedStorage",
    "notifications",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "declarativeNetRequest",
    "contextMenus"
  ],
  "host_permissions": ["http://*/", "https://*/"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "img/read.crx_16x16.png",
      "32": "img/read.crx_32x32.png",
      "64": "img/read.crx_64x64.png"
    },
    "default_title": "read.crx-2を開く"
  },
  "icons": {
    "16": "img/read.crx_16x16.png",
    "32": "img/read.crx_32x32.png",
    "48": "img/read.crx_48x48.png",
    "96": "img/read.crx_96x96.png",
    "128": "img/read.crx_128x128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.2ch.net/*",
        "*://*.5ch.net/*",
        "*://*.5ch.io/*",
        "*://jbbs.shitaraba.net/*",
        "*://*.machi.to/*",
        "*://*.open2ch.net/*",
        "*://*.2ch.sc/*",
        "*://*.2ch.sc/*",
        "*://*.bbspink.com/*",
        "*://bbs.eddibb.cc/*"
      ],
      "js": ["./cs_addlink.js"]
    },
    {
      "matches": [
        "*://*/test/bbs.cgi*",
        "*://jbbs.shitaraba.net/bbs/write.cgi/*",
        "*://*.machi.to/*",
        "*://bbs.eddibb.cc/*"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "js": ["./cs_addlink.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["/view/index.html", "/lib/monaco/vs/**/*"],
      "matches": [
        "*://*.2ch.net/*",
        "*://*.5ch.net/*",
        "*://*.5ch.io/*",
        "*://jbbs.shitaraba.net/*",
        "*://*.machi.to/*",
        "*://*.open2ch.net/*",
        "*://*.2ch.sc/*",
        "*://*.bbspink.com/*",
        "*://bbs.eddibb.cc/*"
      ],
      "extension_ids": []
    }
  ],
  "applications": {
    "gecko": {
      "id": "read.crx2@read.crx",
      "strict_min_version": "103.0"
    }
  }
}
